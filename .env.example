# ═══════════════════════════════════════════════════════════════════════════
# MENTORA AI — server configuration
#
# Copy this file to  .env  and fill in your key. The .env file is gitignored,
# so your API key never enters the repo or the frontend bundle — it stays on
# the proxy server (server/server.mjs).
#
# Any OpenAI-compatible provider works — just point AI_BASE_URL at it:
#   OpenAI      https://api.openai.com/v1        model e.g. gpt-4o-mini
#   Groq        https://api.groq.com/openai/v1   model e.g. llama-3.3-70b-versatile
#   OpenRouter  https://openrouter.ai/api/v1     model e.g. openai/gpt-4o-mini
#   DeepSeek    https://api.deepseek.com/v1      model e.g. deepseek-chat
#   Ollama      http://localhost:11434/v1        model e.g. llama3.1
#   LM Studio   http://localhost:1234/v1         (id of the loaded model)
# ═══════════════════════════════════════════════════════════════════════════

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Port the proxy server listens on (Vite forwards /api/* here)
AI_SERVER_PORT=8788

# ── Netlify (production) ─────────────────────────────────────────────────────
# The deployed site runs the same AI backend as Netlify Functions
# (netlify/functions/). Set the three variables above — AI_API_KEY,
# AI_BASE_URL, AI_MODEL — under Site configuration > Environment variables
# (default scopes: Builds + Functions). They are read server-side only, so
# the key never appears in the frontend bundle.
